#!/bin/sh
# live-build configuration for the Symbiote OS live ISO.
# Run via `lb config` (build.sh does this for you).
set -e

# --firmware-chroot false: live-build otherwise installs every firmware-*
# package in the archive, and one of them — firmware-b43-installer — ships no
# firmware at all. Its postinst downloads it from github.com and openwrt.org,
# so a build either fails outright ("unable to resolve host address") or
# succeeds by luck. The firmware this image needs is listed explicitly in
# config/package-lists/desktop.list.chroot.
#
# No comments inside the invocation below: the lines are joined by trailing
# backslashes, so a "#" comments out every option after it — silently.
lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--iso-application "Symbiote OS" \
	--iso-publisher "Symbiote OS" \
	--iso-volume "SYMBIOTE" \
	--memtest none \
	--apt-recommends false \
	--firmware-chroot false \
	--firmware-binary false \
	--debian-installer none \
	--apt-indices false \
	--bootappend-live "boot=live components quiet splash username=symbiote hostname=symbiote-01 persistence persistence-encryption=none,luks" \
	"${@}"
