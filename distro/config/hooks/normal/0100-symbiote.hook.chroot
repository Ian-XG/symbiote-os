#!/bin/sh
# Runs inside the chroot while the image is being built.
set -e

echo "I: configuring symbiote session"

# The live user greetd logs in as. live-build's own user is created later by
# live-config, so we make ours explicitly and give it the seat/video access
# cage needs to become DRM master.
if ! id symbiote >/dev/null 2>&1; then
	adduser --disabled-password --gecos "Symbiote Operator" symbiote
fi

# A known password, and sudo without one.
#
# This was --disabled-password only, which meant that when the graphical
# session failed there was no way to log in on a VT and find out why — the
# machine was simply unrecoverable. On a live image that is worse than the
# minor exposure of a documented default credential.
echo 'symbiote:symbiote' | chpasswd
adduser symbiote sudo
printf 'symbiote ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/symbiote
chmod 0440 /etc/sudoers.d/symbiote
adduser symbiote video
adduser symbiote input
adduser symbiote render
adduser symbiote netdev      # lets NetworkManager accept its wifi calls
adduser symbiote bluetooth   # lets BlueZ accept pairing calls

# Re-apply /etc/skel over the home directory.
#
# adduser copies skel once, at the moment the account is created, and whether
# that happens before or after live-build has laid down config/includes.chroot
# is an ordering detail of live-build rather than a promise. Getting it wrong
# would not fail the build: it would produce an image where the shipped
# defaults — the terminal theme, the GTK styling, the desktop-entry overrides
# that hide duplicate launcher entries — were simply absent, with nothing
# anywhere to say so. Copying again here costs a few kilobytes and settles it.
if [ -d /etc/skel ]; then
	cp -rn /etc/skel/. /home/symbiote/ 2>/dev/null || true
	chown -R symbiote:symbiote /home/symbiote
fi

chmod 755 /usr/local/bin/symbiote-session
chmod 755 /usr/local/bin/symbiote-shell-run

systemctl enable greetd
systemctl enable NetworkManager
systemctl enable bluetooth
systemctl enable seatd

# Nothing should draw on the console before greetd takes vt1, but tty2-6 keep
# their gettys on purpose: Ctrl+Alt+F2 is the way back in when the graphical
# session will not start.
systemctl disable getty@tty1.service || true
systemctl enable getty@tty2.service || true
systemctl enable getty@tty3.service || true

echo "I: symbiote session configured"
