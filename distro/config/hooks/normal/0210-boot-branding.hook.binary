#!/bin/sh
# Runs after the binary stage, on the assembled image tree.
#
# Replaces the Debian branding in the boot menu: the swirl splash and the
# "Live System" entry labels. live-build writes these itself during the
# bootloader stages, so dropping files in includes.binary is not enough —
# whatever is there gets overwritten. This runs afterwards.
#
# The paths are searched rather than assumed, and the count is checked at the
# end, for the same reason as 0200: a hardcoded path that matches nothing looks
# exactly like success.
set -e

echo "I: applying boot branding"

# The splash the chroot stage carried through, if it is there.
SPLASH=""
for candidate in \
	./isolinux/splash.png \
	../isolinux/splash.png \
	./binary/isolinux/splash.png
do
	[ -f "$candidate" ] && SPLASH="$candidate" && break
done

patched=0

# ── isolinux / syslinux (BIOS) ─────────────────────────────────────────────
for d in $(find . .. -maxdepth 4 -type d -name isolinux 2>/dev/null); do
	if [ -n "$SPLASH" ] && [ "$SPLASH" != "$d/splash.png" ]; then
		cp "$SPLASH" "$d/splash.png" 2>/dev/null || true
	fi
	# Debian's theme names the background in these; point them all at ours.
	for cfg in "$d"/*.cfg; do
		[ -f "$cfg" ] || continue
		sed -i 's|^menu background .*|menu background splash.png|' "$cfg" 2>/dev/null || true
		sed -i 's/Debian GNU\/Linux/Symbiote OS/g; s/^menu title .*/menu title Symbiote OS/' "$cfg" 2>/dev/null || true
		sed -i 's/Live System (\(.*\))/Symbiote OS (\1)/g; s/^menu label \^Live System$/menu label ^Symbiote OS/' "$cfg" 2>/dev/null || true
		sed -i 's/Live System/Symbiote OS/g' "$cfg" 2>/dev/null || true
	done
	echo "I:   branded $d"
	patched=$((patched + 1))
done

# ── grub (UEFI) ────────────────────────────────────────────────────────────
for cfg in $(find . .. -maxdepth 5 -name 'grub.cfg' 2>/dev/null); do
	sed -i 's/Live System/Symbiote OS/g; s/Debian GNU\/Linux/Symbiote OS/g' "$cfg" 2>/dev/null || true
	# grub needs to be told to load a background at all.
	if ! grep -q 'background_image' "$cfg"; then
		dir=$(dirname "$cfg")
		[ -f "$dir/splash.png" ] || cp "$SPLASH" "$dir/splash.png" 2>/dev/null || true
		sed -i '1i if background_image /boot/grub/splash.png ; then true ; fi' "$cfg" 2>/dev/null || true
	fi
	echo "I:   branded $cfg"
	patched=$((patched + 1))
done

if [ "$patched" -eq 0 ]; then
	echo "W: BOOT BRANDING NOT APPLIED — no isolinux or grub tree found" >&2
	echo "W: the menu will still say Debian" >&2
fi
