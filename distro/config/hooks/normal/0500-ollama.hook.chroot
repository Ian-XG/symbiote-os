#!/bin/sh
# Ollama, for running local models.
#
# Not in Debian, and its upstream installer is a curl-to-shell that also tries
# to create a systemd unit and a user. This does the parts that make sense in a
# chroot and nothing else: fetch the release tarball, unpack it, add a unit.
#
# If the build has no network this leaves ollama out and says so, rather than
# shipping a launcher that fails when clicked.
set -e

VERSION="v0.5.7"
URL="https://github.com/ollama/ollama/releases/download/${VERSION}/ollama-linux-amd64.tgz"

echo "I: fetching ollama ${VERSION}"
if ! curl -fsSL --retry 2 --max-time 600 -o /tmp/ollama.tgz "$URL"; then
	echo "W: OLLAMA NOT INSTALLED — could not download ${URL}" >&2
	echo "W: the image is fine, it just will not have local models" >&2
	exit 0
fi

mkdir -p /usr/local
tar -xzf /tmp/ollama.tgz -C /usr/local
rm -f /tmp/ollama.tgz

if [ ! -x /usr/local/bin/ollama ]; then
	echo "W: OLLAMA NOT INSTALLED — the archive had no bin/ollama" >&2
	exit 0
fi

# Its own user, and no network exposure: the API binds to localhost only.
adduser --system --group --home /var/lib/ollama --no-create-home ollama 2>/dev/null || true
mkdir -p /var/lib/ollama
chown ollama:ollama /var/lib/ollama

cat > /etc/systemd/system/ollama.service <<'UNIT'
[Unit]
Description=Ollama
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
# Localhost only. The firewall would block outside access anyway, but a model
# server should not be listening on the network to begin with.
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=HOME=/var/lib/ollama

[Install]
WantedBy=multi-user.target
UNIT

systemctl enable ollama.service
echo "I: ollama installed at /usr/local/bin/ollama"
