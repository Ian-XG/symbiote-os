#!/bin/sh
# PentAI, preinstalled.
#
# Into a virtualenv at /opt/pentai rather than the system Python: Debian marks
# its interpreter externally-managed (PEP 668), so `pip install` into it is
# refused outright — and overriding that is how you break apt later.
#
# --system-site-packages so the dependencies Debian already packages are
# reused instead of downloaded twice.
set -e

REPO=https://github.com/Ian-XG/PentAI.git
DEST=/opt/pentai

echo "I: installing PentAI"

if ! git clone --depth 1 "$REPO" /tmp/pentai-src 2>/dev/null; then
	# A build without network should say so rather than produce an image with
	# a launcher that fails when somebody clicks it.
	# Fails the build rather than shipping without it, for the same reason
	# the Ollama hook does: a warning in a long log is not a signal.
	echo "E: could not clone PentAI — refusing to ship an image without it" >&2
	exit 1
fi

python3 -m venv --system-site-packages "$DEST"
"$DEST/bin/pip" install --quiet --no-cache-dir /tmp/pentai-src || {
	echo "E: PentAI failed to install" >&2
	rm -rf "$DEST"
	rm -rf /tmp/pentai-src
	exit 1
}
rm -rf /tmp/pentai-src

# On PATH under its own name.
ln -sf "$DEST/bin/pentai" /usr/local/bin/pentai

cat > /usr/share/applications/pentai.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=PentAI
GenericName=Terminal AI agent
Comment=Plans and runs security testing commands, one confirmed step at a time
Exec=foot -T PentAI pentai
Icon=utilities-terminal
Terminal=false
Categories=Security;System;
DESKTOP

echo "I: PentAI installed at $DEST"
