#!/bin/sh
# Trim the image so it fits a single 2 GiB release asset.
#
# The ISO landed at 2.04 GB — ~40 MB over GitHub's per-file release-asset
# limit — which forced it to be published in split parts. This removes what a
# live image does not need at runtime and nothing that a tool does, so the
# image ships as one direct .iso instead.
#
# Runs last (9900) so it strips everything the earlier hooks installed —
# Ollama, PentAI and the whole package set — not just the base system.
#
# NOTHING FUNCTIONAL GOES:
#  - /usr/share/doc: the prose is dropped, but every `copyright` file is kept,
#    so the licences the image is obliged to carry stay with it.
#  - man and info pages: reference text, regenerated by no one on a live stick.
#  - locales other than English: the image boots `en`; the translation
#    catalogues for dozens of other languages are dead weight here.
set -e

echo "I: slimming the image for a single-file release"

before=$(du -sx -BM / 2>/dev/null | cut -f1 || echo '?')

# ── documentation, minus the copyright files ────────────────────────────────
# Debian policy wants each package's copyright kept; everything else in
# /usr/share/doc is safe to drop on a live image.
find /usr/share/doc -type f ! -name 'copyright' -delete 2>/dev/null || true
find /usr/share/doc -type l -delete 2>/dev/null || true
find /usr/share/doc -type d -empty -delete 2>/dev/null || true

# ── man and info ────────────────────────────────────────────────────────────
rm -rf /usr/share/man/* /usr/share/info/* /usr/share/groff/* 2>/dev/null || true

# ── locales, keeping English and the C fallback ─────────────────────────────
if [ -d /usr/share/locale ]; then
	find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
		! -name 'en' ! -name 'en_*' ! -name 'C' ! -name 'C.*' \
		-exec rm -rf {} + 2>/dev/null || true
fi
# Qt's own translations, same rule.
if [ -d /usr/share/qt6/translations ]; then
	find /usr/share/qt6/translations -type f ! -name '*_en.qm' \
		-delete 2>/dev/null || true
fi

# ── apt bookkeeping ─────────────────────────────────────────────────────────
# --apt-indices false already drops most of this; clean whatever is left so the
# squashfs is not carrying a package cache nobody reads.
apt-get clean 2>/dev/null || true
rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb 2>/dev/null || true

after=$(du -sx -BM / 2>/dev/null | cut -f1 || echo '?')
echo "I: chroot was ${before}, now ${after}"
