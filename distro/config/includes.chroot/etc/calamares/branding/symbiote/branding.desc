---
componentName: symbiote

# Calamares is Qt Widgets, not the shell's QML, so it cannot be made to look
# like the HUD without rewriting it. What it can do is carry the right name and
# the right palette, so it does not announce itself as Debian halfway through
# installing Symbiote.
strings:
    productName:         Symbiote OS
    shortProductName:    Symbiote
    version:             1.0
    shortVersion:        1.0
    versionedName:       Symbiote OS 1.0
    shortVersionedName:  Symbiote 1.0
    bootloaderEntryName: Symbiote
    productUrl:          https://github.com/Ian-XG/symbiote-os
    supportUrl:          https://github.com/Ian-XG/symbiote-os/issues

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow: "show.qml"
slideshowAPI: 2

style:
    sidebarBackground:    "#080808"
    sidebarText:          "#c8c8c8"
    sidebarTextSelect:    "#00ff88"
    sidebarTextHighlight: "#04412a"
