# Let the desktop change screen brightness.
#
# /sys/class/backlight/*/brightness is root-owned, so a shell running as the
# operator cannot write it and the brightness control would be decorative.
# Handing the `video` group write access is the conventional answer, and the
# operator is already in that group.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness"
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
