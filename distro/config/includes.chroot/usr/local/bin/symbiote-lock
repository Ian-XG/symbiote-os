#!/bin/sh
# Lock the screen, in the shell's own colours.
#
# swaylock draws the lock screen itself — it has to, since the point is that
# nothing else can be on top of it. These are the design's tokens so the lock
# does not look like a different machine's.
exec swaylock \
	--daemonize \
	--ignore-empty-password \
	--show-failed-attempts \
	--color 080808 \
	--inside-color 00000000 \
	--inside-clear-color 00000000 \
	--inside-ver-color 00000000 \
	--inside-wrong-color 00000000 \
	--ring-color 00ff88 \
	--ring-clear-color 1aff00 \
	--ring-ver-color 00d9ff \
	--ring-wrong-color ff1744 \
	--key-hl-color 1aff00 \
	--bs-hl-color ff1744 \
	--separator-color 00000000 \
	--text-color c8c8c8 \
	--text-clear-color c8c8c8 \
	--text-ver-color 00d9ff \
	--text-wrong-color ff1744 \
	--line-color 00000000 \
	--line-clear-color 00000000 \
	--line-ver-color 00000000 \
	--line-wrong-color 00000000 \
	--indicator-radius 90 \
	--indicator-thickness 6 \
	--font "JetBrains Mono" \
	"$@"
