#!/bin/bash
# Turn a spare partition on the boot medium into persistent storage.
#
# A live image forgets everything on reboot — every setting changed, every
# icon pinned, every file saved. live-build supports persistence, but it needs
# a partition labelled "persistence" holding a persistence.conf, and nothing
# creates that for you.
#
# This makes one, optionally encrypted. It never touches a mounted filesystem
# and it always names the device and its size before doing anything.
set -euo pipefail

usage() {
	cat <<'USAGE'
symbiote-persist - create persistent storage for this live image

    symbiote-persist list                  show candidate partitions
    symbiote-persist init <device>         format <device> for persistence
    symbiote-persist auto                  use the free space on the boot medium
    symbiote-persist init <device> --luks  same, encrypted with a passphrase

The device must be a partition (for example /dev/sdb3), not a whole disk, and
must not be mounted. Everything on it is destroyed.
USAGE
}

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		echo "This needs root: sudo symbiote-persist $*" >&2
		exit 1
	fi
}

case "${1:-}" in
list)
	parts=$(lsblk -lno NAME,TYPE | awk '$2=="part"{print $1}')
	if [ -n "$parts" ]; then
		echo "Partitions on this machine:"
		lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,TYPE | awk 'NR==1 || $NF=="part"'
		echo
		echo "The live medium itself is mounted; pick a partition that is not."
	else
		echo "No partitions on this machine."
	fi

	# Whole disks carrying no partitions at all.
	#
	# These were invisible. The table above lists partitions, so a blank spare
	# drive — the obvious thing to point this at — produced an empty list, and
	# `init` refuses a whole disk because formatting one destroys the live image
	# along with it. Between the two there was no way through and nothing saying
	# so: on a machine with a 20 GB blank disk, `list` printed a header, no rows,
	# and a line about picking an unmounted partition.
	blank=""
	for d in $(lsblk -dno NAME,TYPE | awk '$2=="disk"{print $1}'); do
		[ -z "$(lsblk -lno NAME,TYPE "/dev/$d" | awk '$2=="part"{print $1}')" ] || continue
		blank="${blank}  /dev/$d  $(lsblk -dno SIZE "/dev/$d" | tr -d ' ')  no partitions\n"
	done

	if [ -n "$blank" ]; then
		echo
		echo "Disks with no partitions on them:"
		printf '%b' "$blank"
		echo
		echo "init takes a partition, not a disk. To give one of these a single"
		echo "partition filling it - this erases that disk, so read the name twice:"
		echo
		echo "    echo ',,L' | sudo sfdisk /dev/sdX"
		echo "    sudo partprobe /dev/sdX"
		echo "    sudo symbiote-persist init /dev/sdX1"
	fi
	;;

init)
	require_root "$@"
	dev="${2:-}"
	[ -b "$dev" ] || { echo "Not a block device: $dev" >&2; exit 1; }

	# Refuse a whole disk. Formatting /dev/sdb instead of /dev/sdb3 destroys
	# the live image along with everything else on the stick.
	if [ "$(lsblk -no TYPE "$dev" | head -1)" != "part" ]; then
		echo "$dev is not a partition. Give a partition such as ${dev}1." >&2
		echo >&2
		echo "If that disk has none, make one - this erases $dev:" >&2
		echo "    echo ',,L' | sudo sfdisk $dev" >&2
		echo "    sudo partprobe $dev" >&2
		exit 1
	fi
	if findmnt -S "$dev" >/dev/null 2>&1; then
		echo "$dev is mounted. Unmount it first." >&2
		exit 1
	fi

	size=$(lsblk -no SIZE "$dev" | head -1)
	model=$(lsblk -no MODEL "$(lsblk -no PKNAME "$dev" | head -1)" 2>/dev/null || true)
	echo "About to ERASE $dev ($size${model:+ on $model})."
	read -r -p "Type ERASE to continue: " confirm
	[ "$confirm" = "ERASE" ] || { echo "Cancelled."; exit 1; }

	target="$dev"
	if [ "${3:-}" = "--luks" ]; then
		echo "Setting up encryption. You will be asked for a passphrase twice,"
		echo "and again on every boot. There is no recovery if you forget it."
		cryptsetup luksFormat "$dev"
		cryptsetup open "$dev" symbiote-persistence
		target=/dev/mapper/symbiote-persistence
	fi

	mkfs.ext4 -L persistence -F "$target"
	mnt=$(mktemp -d)
	mount "$target" "$mnt"
	# "/ union" overlays the whole filesystem, so anything written anywhere
	# survives — not just the home directory.
	echo "/ union" > "$mnt/persistence.conf"
	umount "$mnt"
	rmdir "$mnt"
	[ "$target" = "$dev" ] || cryptsetup close symbiote-persistence

	echo
	echo "Done. Reboot and this partition will hold your changes."
	;;

auto)
	# Called by the desktop when it notices unallocated space on the medium
	# this system booted from. Everything destructive still happens here,
	# behind the same typed confirmation: the shell only opens the door.
	require_root "$@"

	MEDIUM=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
	if [ -z "$MEDIUM" ]; then
		echo "Not running from live media - nothing to add persistence to." >&2
		exit 1
	fi

	# The partition the image is on; its parent disk is what has the space.
	PART=$(basename "$MEDIUM")
	DISK=$(lsblk -no PKNAME "$MEDIUM" 2>/dev/null | head -1)
	[ -n "$DISK" ] || { echo "Could not identify the disk behind $MEDIUM." >&2; exit 1; }
	DEV="/dev/$DISK"

	if lsblk -no LABEL "$DEV" 2>/dev/null | grep -qx persistence; then
		echo "This medium already has a persistence partition."
		exit 0
	fi

	FREE=$(sfdisk --list-free "$DEV" 2>/dev/null | awk '/^ /{print $NF}' | tail -1)
	echo "Boot medium : $DEV"
	echo "Free space  : ${FREE:-unknown}"
	echo
	echo "This creates a new partition in the unallocated space at the end of"
	echo "$DEV and formats it. The existing partitions, including the one this"
	echo "system is running from, are not touched - but partitioning the disk"
	echo "you booted from is not risk-free, and there is no undo."
	read -r -p "Type ERASE to continue: " confirm
	[ "$confirm" = "ERASE" ] || { echo "Cancelled."; exit 1; }

	# ",," means: start after the last partition, use everything left.
	echo ',,L' | sfdisk --append --no-reread "$DEV" || {
		echo "Could not add a partition. Is there unallocated space?" >&2
		exit 1
	}
	partprobe "$DEV" 2>/dev/null || true
	sleep 2

	NEW=$(lsblk -lno NAME,TYPE "$DEV" | awk '$2=="part"{print $1}' | tail -1)
	[ -n "$NEW" ] || { echo "The new partition did not appear." >&2; exit 1; }
	TARGET="/dev/$NEW"
	echo "Formatting $TARGET"

	mkfs.ext4 -q -L persistence -F "$TARGET"
	mnt=$(mktemp -d)
	mount "$TARGET" "$mnt"
	echo "/ union" > "$mnt/persistence.conf"
	umount "$mnt"
	rmdir "$mnt"

	echo
	echo "Done. Reboot and this medium will keep your changes."
	;;

*)
	usage
	;;
esac
