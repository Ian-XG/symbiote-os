#!/bin/bash
# Screenshots.
#
#   symbiote-shot            whole screen
#   symbiote-shot region     drag a rectangle
#   symbiote-shot window     the focused window
#
# Saved under ~/Pictures and copied to the clipboard, because a screenshot you
# then have to go and find is half a feature.
set -euo pipefail

DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
mkdir -p "$DIR"
OUT="$DIR/symbiote-$(date +%Y%m%d-%H%M%S).png"

case "${1:-full}" in
region)
	# slurp writes the geometry; cancelling it must not leave a stray file.
	geom=$(slurp 2>/dev/null) || { echo "cancelled" >&2; exit 1; }
	grim -g "$geom" "$OUT"
	;;
window)
	# labwc has no "focused window geometry" query, so this is the same
	# drag as region rather than a promise it cannot keep.
	geom=$(slurp 2>/dev/null) || { echo "cancelled" >&2; exit 1; }
	grim -g "$geom" "$OUT"
	;;
*)
	grim "$OUT"
	;;
esac

wl-copy --type image/png < "$OUT" 2>/dev/null || true
echo "$OUT"
