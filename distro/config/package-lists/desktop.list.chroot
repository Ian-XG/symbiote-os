# NOTE: live-build passes every non-comment line straight to apt, and it does
# NOT strip trailing comments. A line like "bluez  # -> bluetooth" is parsed as
# three arguments and apt dies on the "->". Comments must own their whole line.

# Session: a Wayland kiosk, not a full desktop environment.
# labwc is a wlroots compositor with window rules, so apps get real windows
# above the shell. cage was used before and could only ever show one window.
labwc
greetd
seatd
xwayland

# Graphics and input
libgl1-mesa-dri
mesa-vulkan-drivers
libinput10

# Audio
pipewire
pipewire-pulse
wireplumber

# The system services the shell drives over D-Bus. These are what actually
# provide wifi and bluetooth; the shell is only their client.
# network-manager -> org.freedesktop.NetworkManager
# bluez           -> org.bluez
# upower          -> org.freedesktop.UPower
network-manager
wpasupplicant
bluez
# bluez-firmware was dropped in trixie — the Bluetooth adapter firmware it
# carried is now shipped by the firmware-* packages below, so naming it here
# fails the build for blobs the image already has.
upower
polkitd
dbus-user-session

# Qt6 runtime for the shell. Replaces the Electron/Chromium stack: the QML
# scene graph keeps the hologram's vector geometry on the GPU instead of
# re-rasterising it every frame, which is what cost a whole CPU core.
libqt6quick6
libqt6qml6
libqt6gui6
libqt6dbus6
qml6-module-qtquick
qml6-module-qtquick-window
qml6-module-qtquick-shapes
qml6-module-qtquick-layouts
qml6-module-qtqml-workerscript
qt6-wayland
qt6-qpa-plugins

# Recovery: without sudo a failed graphical session leaves no way back in.
sudo

# Graphics firmware. Missing firmware for whichever GPU drives the display
# means no working GL, which is one of the ways the shell ends up on a blank
# screen.
#
# firmware-intel-graphics is back. A comment here used to claim it had been
# folded into firmware-misc-nonfree and was "not a package in trixie". It is a
# package in trixie, 29 MB of it, and the claim was written from memory rather
# than checked against the archive.
firmware-amd-graphics
firmware-intel-graphics
firmware-intel-misc
firmware-misc-nonfree

# Firmware for real hardware. Wireless and Bluetooth chips do not come up
# without it, and a live image that cannot reach a network is close to useless.
#
# This list was three vendors long and it was not enough. On an MSI laptop the
# desktop reported "no adapter" — no wireless device at all — because the chip
# was a MediaTek and no MediaTek firmware was on the image. A second comment
# here claimed firmware-brcm80211 had been "folded into firmware-linux and is
# no longer a package of its own". It is a package, it is 18 MB, and Broadcom
# is what a great many laptops have. Both claims were remembered, not checked.
#
# Every wireless vendor a laptop or a USB dongle is likely to be is now named
# explicitly. What is deliberately left out, and why:
#
#   firmware-b43-installer, -b43legacy-installer   download from the internet
#       in their postinst. That is what broke the build and what
#       --firmware-chroot false exists to avoid; naming them would bring it
#       straight back.
#   firmware-qcom-soc (305 MB), -netronome (144 MB), -marvell-prestera (60 MB)
#       phones, server NICs and switch ASICs. Nothing that boots this.
#   firmware-nvidia-*  (185 MB for the set) nouveau drives the display without
#       it, and the image has a 2 GB ceiling to stay a single-file release.
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-mediatek
firmware-brcm80211
firmware-ti-connectivity
firmware-ath9k-htc
firmware-zd1211
firmware-carl9170

# Audio on a modern laptop goes through a DSP, and the DSP needs firmware.
# Without sof-signed the speakers on most Intel machines from about 2019 are
# simply silent — no error, no device, nothing.
firmware-sof-signed
firmware-intel-sound
firmware-cirrus

# Named here rather than left to dependency resolution. These arrived for
# Electron, which the image no longer ships, but every one of them is still
# wanted: libnss3 by Firefox, libgtk-3-0 and libatk-bridge2.0-0 by the GTK3
# applications, libasound2 by anything making a sound, libgbm1 by Mesa.
libnss3
libatk-bridge2.0-0
libgtk-3-0
libasound2
libgbm1

fonts-jetbrains-mono
# Icon themes, so installed applications can show their own icon instead of a
# drawn placeholder. hicolor is where an application drops its own; adwaita is
# the fallback for anything that relies on the desktop providing one.
hicolor-icon-theme
adwaita-icon-theme
# SVG icons are common; without these Qt cannot decode one at all.
#
# libqt6svg6 alone was not enough and looked like it was. It ships the
# renderer, not the QImageIOPlugin that teaches QImage the format, so every
# .svg the launcher reached for failed with "Unsupported image format" and
# fell back to the line-art glyph. Files, Papers, the archive manager and the
# image viewer all ship SVG only, so all four lost their real icon — which is
# the opposite of what this image is meant to do with non-Symbiote apps.
libqt6svg6
qt6-svg-plugins
# Reads and rewrites the monitor layout. labwc speaks wlr-output-management;
# this is that protocol's reference client, and it is what the Screens page in
# Settings drives. Without it the page can still list the displays — Qt knows
# them — but it says so and offers nothing it cannot deliver.
wlr-randr
# Keeps the clock right on its own.
#
# Settings grew a "network time" switch and timedatectl reported CanNTP=no:
# nothing on the image implemented it, so the switch would have been a control
# that reported success and changed nothing. With this the clock corrects
# itself the moment the machine has a network, which also spares most people
# from having to find the timezone page at all.
systemd-timesyncd

# The commands applications shell out to.
#
# All three were missing and each one fails quietly. Without xdg-open a link
# clicked in a terminal, or "open containing folder" in a download, does
# nothing at all — the caller gets "command not found" on a stream nobody is
# reading. notify-send is how scripts and the odd application raise a
# notification now that the shell answers org.freedesktop.Notifications.
# lspci is the first thing anyone reaches for on a machine whose graphics or
# wireless is not working, which on a live image is the whole point.
xdg-utils
libnotify-bin
pciutils
# Screen backlight. wpctl handles volume and ships with wireplumber, which is
# already above; brightness needs its own tool.
brightnessctl

# symbiote-persist auto adds a partition in the free space of the boot medium:
# sfdisk comes with util-linux, partprobe does not.
parted

# Screen lock, idle handling and screenshots. A laptop you carry, with no lock
# screen, is not a secure system whatever the firewall says; and a machine for
# security work with no way to capture the screen cannot document anything.
swaylock
swayidle
grim
slurp
wl-clipboard
# swayidle turns the panel off through this.
wlopm

# Lets applications take screenshots and share screens through the portal
# rather than each needing compositor privileges.
xdg-desktop-portal-wlr
xdg-desktop-portal
