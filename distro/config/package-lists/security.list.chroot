# Security tooling available in Debian main.
# Note: Metasploit and Burp Suite are NOT in Debian — they need either the Kali
# repo or a vendor installer. See distro/README-tools.md before adding them.

nmap
ncat
tcpdump
wireshark
tshark
aircrack-ng
hydra
john
hashcat
sqlmap
dirb
gobuster
masscan
netcat-openbsd
socat
openvpn
wireguard-tools
proxychains4
whois
dnsutils
git
python3
python3-pip
python3-venv
build-essential

# The shell reads the firewall with nft and falls back to iptables-save, and
# the FIREWALL app runs `nft list ruleset`. Neither binary was installed, so
# the panel reported "NOT RUNNING" for a machine that simply had no nft, and
# the app opened a terminal saying command not found.
nftables
iptables
# AppArmor confines applications to the files and capabilities they declare.
# Debian ships the profiles but nothing turns them on; the hook does.
apparmor
apparmor-profiles
apparmor-utils
# For symbiote-persist --luks: encrypting the persistence partition.
cryptsetup
# PentAI is installed from source by hooks/normal/0500-pentai.hook.chroot;
# these are what its virtualenv builds against, and packaging them here means
# the venv reuses Debian's copies instead of fetching its own.
python3-prompt-toolkit
python3-rich
python3-httpx
python3-yaml

# ── the rest of the kit ─────────────────────────────────────────────────────
# Chosen for coverage rather than completeness: one or two tools for each thing
# an operator actually does, not every tool that does it. Everything here is in
# Debian main — the workflow in .github/workflows/packages.yml checks that on
# every change, because live-build feeds these lines to apt verbatim and one
# wrong name fails the build twenty minutes in.
#
# Still missing, and still not packaged by Debian: Metasploit, Burp Suite,
# CrackMapExec, SecLists. See distro/README-tools.md.

# Downloading things the hooks install (Ollama, PentAI).
curl
ca-certificates

# ── information gathering ───────────────────────────────────────────────────
# theHarvester is not in trixie — it lives in Kali, and pip/pipx is the way to
# get it here. Left out rather than named, so the build does not fail for it.
dnsrecon
dnsenum
netdiscover
fping
sslscan
whatweb
smbclient
nbtscan
onesixtyone

# ── vulnerability analysis ──────────────────────────────────────────────────
# nikto and wapiti are both absent from trixie — nikto was removed outright,
# wapiti has no installation candidate. Both are in README-tools.md. lynis is
# the system auditor that is packaged and installable.
lynis

# ── web application ─────────────────────────────────────────────────────────
# gobuster is already listed above; not repeated here.
ffuf
wfuzz

# ── password attacks ────────────────────────────────────────────────────────
medusa
ncrack
crunch
cewl

# ── wireless ────────────────────────────────────────────────────────────────
reaver
wifite
mdk4
hcxtools
hcxdumptool
macchanger
iw

# ── sniffing and spoofing ───────────────────────────────────────────────────
# Responder is not packaged in Debian; it is a Kali/GitHub tool. Left out
# rather than named so the build does not fail for it.
# mitmproxy has no installation candidate in trixie; `pipx install mitmproxy`
# is the way to get it. bettercap and dsniff cover the interception need here.
ettercap-text-only
dsniff
bettercap
netsniff-ng

# ── reverse engineering ─────────────────────────────────────────────────────
# Neither radare2 nor its fork rizin is in trixie; both are in README-tools.md
# as external installs. gdb, objdump (binutils), ltrace, strace and binwalk are
# the packaged coverage. objdump comes with binutils, pulled by build-essential,
# but naming it makes the disassembler explicit rather than incidental.
binutils
gdb
ltrace
strace
binwalk
hexedit

# ── forensics ───────────────────────────────────────────────────────────────
sleuthkit
foremost
testdisk
libimage-exiftool-perl
steghide

# ── post exploitation ───────────────────────────────────────────────────────
python3-impacket
rlwrap

# ── anonymity ───────────────────────────────────────────────────────────────
tor
torsocks

# Tools PentAI probes for and reported missing on real hardware.
#
# PentAI prints a tick or a cross for each tool it can drive. On the first boot
# on a real machine several were crosses, which makes the assistant advertise
# capabilities the image cannot deliver. These three are the ones Debian
# carries; wpscan, enum4linux, rustscan and subfinder are not in the archive at
# all and would each need fetching from their own release page at build time.
nikto
dirsearch
recon-ng

# Needed by 0550-pentest-tools.hook.chroot, which fetches the four tools Debian
# does not carry. unzip opens subfinder's release archive; samba-common-bin is
# what enum4linux actually drives — rpcclient and nmblookup — and without it the
# script installs cleanly and then fails on every target.
unzip
samba-common-bin

# VPN. No third-party client and no third-party apt repository: the machine
# already has openvpn and wireguard-tools, and this is the NetworkManager
# plugin that lets a .ovpn profile be imported and switched on like any other
# connection. It works with Mullvad, Proton, a corporate gateway or anything
# else that hands out a profile, rather than backing two providers and their
# signing keys into a security image.
network-manager-openvpn
